# --- Docker Compose (read by `docker compose` itself) -------------------------------------------------------------
# Add your GPU's file so Ollama uses it (pick ONE; leave as-is for CPU only):
#   NVIDIA:            COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-nvidia.yml
#   AMD (ROCm):        COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-amd.yml
#   Intel / other:     COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-vulkan.yml
COMPOSE_FILE=docker-compose.yml
# The user compbot runs as - must own ./data (TrueNAS "apps" is 568; use your own uid, e.g. 3000, if you prefer)
COMPBOT_UID=568
COMPBOT_GID=568

# --- compbot -------------------------------------------------------------------------------------------------------
TZ=Europe/London
WEB_USER=rob
WEB_PASSWORD=change-me
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_FOLDERS=INBOX,[Gmail]/Spam
NOTIFY_EMAIL=
NTFY_URL=
DISCOVER_CRON=0 7 * * *
ENTER_CRON=30 7 * * *
INBOX_CRON=0 8,20 * * *
MAINTENANCE_CRON=0 3 * * *
# AI: the bundled Ollama service is wired up automatically (OLLAMA_URL) - pick the model in Settings.
# Only set these to use a different OpenAI-compatible endpoint instead:
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
